# ============================================
# CONFIGURACIÓN DE BASE DE DATOS - BDM SEGUROS
# ============================================
# Instrucciones:
# 1. Copia este archivo como ".env"
# 2. Modifica los valores según tu entorno local
# 3. NUNCA subas el archivo .env al repositorio

# Datos de conexión MySQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
#si no hay datos o estan vacios en tú configuracion,
# no agregues nada, asi dejalo vacio.

# Entorno de desarrollo
APP_ENV=development
APP_DEBUG=true